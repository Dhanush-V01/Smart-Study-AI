# Optional: Google Gemini API Key (without this, SmartStudy AI runs in Demo Mode)
GEMINI_API_KEY=

# Optional: Free Permanent Cloud Sync (for Streamlit Community Cloud)
# Point to a separate PRIVATE GitHub repo to auto-save smartstudy.db & uploaded files
GITHUB_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=smartstudy.db
